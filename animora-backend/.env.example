# Server
PORT=8000
NODE_ENV=development

# MongoDB Atlas (or local) connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/animora

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of allowed frontend origins (used for CORS).
# Leave unset in local dev to allow all origins.
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500

# Used only by `npm run create-admin` to create/promote an admin user — not read at server boot.
ADMIN_NAME=Animora Admin
ADMIN_EMAIL=admin@animora.com
ADMIN_PASSWORD=ChangeMe123!
